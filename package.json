{
  "name": "react-leaflet-zarr-large-grid",
  "version": "0.1.0",
  "description": "React Leaflet layer that paints a large 2D Zarr float grid as a heatmap, reading only the visible area.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^18.0.0 || ^20.0.0 || >=22.0.0",
    "npm": ">=9.0.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "npm run dev -w react-leaflet-zarr-large-grid-demo"
  },
  "workspaces": [
    "examples/demo"
  ],
  "peerDependencies": {
    "leaflet": "^1.9.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0"
  },
  "dependencies": {
    "@react-leaflet/core": "^3.0.0",
    "zarrita": "^0.7.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-leaflet": "^5.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
